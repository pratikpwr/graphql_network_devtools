# Source of the extension web app. Its compiled output is published in
# extension/devtools/build.
extension_app/

# Build artifacts at the root only. extension/devtools/build is published.
/build/
example/build/
.dart_tool/
pubspec.lock

# IDE and OS files
.idea/
.vscode/
*.iml
.DS_Store

# Flutter generated files
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Repository tooling
.github/
tool/
coverage/

# CanvasKit is large. Flutter web loads it from the gstatic CDN at runtime.
extension/devtools/build/canvaskit/
extension/devtools/build/**/*.symbols
